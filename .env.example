# Server-side settings for Agent Work Recovery. Set these as environment variables on the host
# (for Vercel: Project Settings > Environment Variables). Never commit real values.

# Required. An agent key for the Ziki project, created in Ziki. Needs contributor level or higher.
ZIKI_AGENT_KEY=

# Required. The passphrase people type to open this page (at least 12 characters).
RECOVERY_ACCESS_TOKEN=

# Required. A long random string used to sign the session cookie (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECOVERY_SESSION_SECRET=

# Optional. Only needed when the agent key is not limited to a single project.
ZIKI_PROJECT_ID=

# Optional. Defaults to https://ziki.dev. Must be https (http is allowed only for localhost).
ZIKI_BASE_URL=
